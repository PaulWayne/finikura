# Medusa integration tests (pnpm --filter medusa test:integration:http).
# Copy to .env.test. The test runner creates a temporary database on this
# PostgreSQL (docker compose, port 5434), runs the migrations and drops it at the end.
# The dev database is never touched. No REDIS_URL: tests use in-memory modules.
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=finikura
DB_PASSWORD=finikura
DB_TEMP_NAME=medusa_test
JWT_SECRET=test-only
COOKIE_SECRET=test-only
STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000,http://localhost:3100
# Quieter output: Medusa logs only errors during tests.
LOG_LEVEL=error
