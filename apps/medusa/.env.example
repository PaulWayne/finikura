STORE_CORS=http://localhost:3100
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3100
REDIS_URL=redis://localhost:6380
JWT_SECRET=change-me
COOKIE_SECRET=change-me
AUTH_MFA_ENCRYPTION_KEY=change-me-64-hex-chars
DATABASE_URL=postgres://finikura:finikura@localhost:5434/medusa

# Storefront cache revalidation (same secret as the storefront's REVALIDATE_SECRET)
STOREFRONT_REVALIDATE_URL=http://localhost:3100/api/revalidate
REVALIDATE_SECRET=change-me

# New-order e-mail, sent to every admin user. Without SMTP_HOST the e-mail is only printed in the console.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fini Kura <commandes@example.com>"
# Base of the admin links in the e-mail
MEDUSA_ADMIN_URL=http://localhost:9000/app
