HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (docker compose)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=strapi
DATABASE_USERNAME=finikura
DATABASE_PASSWORD=finikura

# Storefront cache revalidation (same secret as the storefront's REVALIDATE_SECRET)
STOREFRONT_REVALIDATE_URL=http://localhost:3100/api/revalidate
REVALIDATE_SECRET=change-me

# Admin "forgot password" e-mails (same Hostinger mailbox as Medusa). Without SMTP_HOST nothing is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Fini Kura <commandes@example.com>"
