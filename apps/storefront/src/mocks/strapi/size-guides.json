      "category_handle": "filles",
      "title": "Guide des tailles — Filles (3 à 14 ans)",
      "measuring_tips": [
        {
          "text": "Mesurez l'enfant debout, sans chaussures, avec un mètre ruban souple, sans serrer."
        },
        {
          "text": "Hauteur : de la tête aux talons, dos contre un mur."
        },
        {
          "text": "Tour de poitrine : à l'horizontale, à l'endroit le plus large."
        },
        {
          "text": "Entre deux tailles, prenez la taille au-dessus : les enfants grandissent vite."
        }
      ],
