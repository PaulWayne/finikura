# Data sources: mock (fixtures in src/mocks) or live (Medusa / Strapi)
COMMERCE_SOURCE=mock
CONTENT_SOURCE=mock

# Medusa (live): Store API URL and the "Site Fini Kura" publishable key (printed by `pnpm --filter medusa seed`)
MEDUSA_BACKEND_URL=http://localhost:9000
MEDUSA_PUBLISHABLE_KEY=
# Public Medusa URL for product images (next/image). Defaults to MEDUSA_BACKEND_URL; set it when that URL is internal (production).
MEDUSA_PUBLIC_URL=

# Strapi (live). STRAPI_TOKEN is optional (read-only API token); public read is enough locally.
STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
# Public Strapi URL for media (images). Defaults to STRAPI_URL; set it when STRAPI_URL is internal (production).
STRAPI_PUBLIC_URL=

# Shared with Medusa and Strapi: protects /api/revalidate
REVALIDATE_SECRET=

# Dev only: Mac IP on the local Wi-Fi, to test the site from a phone (next dev).
DEV_LAN_HOST=

# Visit statistics (Umami, FK-10). Leave empty to load no script (mock, dev, e2e).
# Production: UMAMI_SCRIPT_URL=https://stats.<domain>/script.js, UMAMI_WEBSITE_ID from the Umami site settings.
UMAMI_SCRIPT_URL=
UMAMI_WEBSITE_ID=

# Media storage (Garage, S3-compatible): public URL of the bucket, allowed for next/image.
# Local: http://localhost:3902 · Production: https://media.<domain>
MEDIA_PUBLIC_URL=

# Public URL of the site, for shared links and link previews (Open Graph).
# Local: http://localhost:3100 · Production: https://<domain>
SITE_URL=

# Orders allowed in a row (audit B2), per phone number and per IP address. Empty: 3 / 10 per phone,
# 10 / 40 per address, in 15 minutes / 24 hours. See docs/deploiement.md.
ORDER_LIMIT_PHONE_15MIN=
ORDER_LIMIT_PHONE_DAY=
ORDER_LIMIT_IP_15MIN=
ORDER_LIMIT_IP_DAY=

# IndexNow (Bing, and through it ChatGPT and Copilot): pages changed in Medusa or Strapi are
# signalled within minutes. 8 to 128 letters, digits or dashes, e.g. the output of
# `openssl rand -hex 16`. Empty: off. Only used when SITE_URL is in https. See docs/deploiement.md.
INDEXNOW_KEY=
