# Fini Kura production variables: paste into Dokploy > Environment, with real values.
# Generate each secret with: openssl rand -hex 32   (APP_KEYS: four values, comma-separated)

# Domain chosen by the client (fini-kura.fr or finikura.fr). Front: DOMAIN, Medusa: api.DOMAIN, Strapi: cms.DOMAIN, Umami: stats.DOMAIN, media: media.DOMAIN
DOMAIN=

# PostgreSQL (one server, databases "medusa" and "strapi")
POSTGRES_USER=finikura
POSTGRES_PASSWORD=

# Medusa
MEDUSA_JWT_SECRET=
MEDUSA_COOKIE_SECRET=
MEDUSA_AUTH_MFA_ENCRYPTION_KEY=
# Publishable key of the "Site Fini Kura" sales channel (printed by the Medusa seed)
MEDUSA_PUBLISHABLE_KEY=
# Hostinger mailbox (e.g. commandes@DOMAIN): new-order alerts, admin invites and password resets (Medusa and Strapi)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Strapi
STRAPI_APP_KEYS=
STRAPI_API_TOKEN_SALT=
STRAPI_ADMIN_JWT_SECRET=
STRAPI_TRANSFER_TOKEN_SALT=
STRAPI_JWT_SECRET=
STRAPI_ENCRYPTION_KEY=
# Optional read-only API token
STRAPI_TOKEN=

# Media storage (Garage). GARAGE_RPC_SECRET: openssl rand -hex 32 · GARAGE_ADMIN_TOKEN: openssl rand -base64 32
# S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY: printed by infra/garage/init.sh after the first deploy
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Umami (visit statistics, FK-10): APP_SECRET, and the site id copied from Umami after the first login
UMAMI_APP_SECRET=
UMAMI_WEBSITE_ID=

# Shared by Medusa, Strapi and the storefront: protects /api/revalidate
REVALIDATE_SECRET=

# Storefront: orders allowed in a row (audit B2), empty = 3 / 10 per phone and 10 / 40 per IP,
# in 15 minutes / 24 hours (docs/deploiement.md). FORCE_REBUILD=1 rebuilds the site at its next restart.
ORDER_LIMIT_PHONE_15MIN=
ORDER_LIMIT_PHONE_DAY=
ORDER_LIMIT_IP_15MIN=
ORDER_LIMIT_IP_DAY=
# Requests per address on the site (audit S6); empty = the defaults: 400 a second, 3000 in a burst,
# and for what changes something (cart, order) 600 a minute, 300 in a burst.
# Wide on purpose: during a TikTok live many phones arrive at once behind one mobile-network address.
FRONT_LIMIT_PER_SECOND=
FRONT_LIMIT_BURST=
FRONT_LIMIT_POST_PER_MINUTE=
FRONT_LIMIT_POST_BURST=
FORCE_REBUILD=

# Storefront, preview before the opening: 1 hides the site from search engines and AI crawlers.
# Visitors with the address still see it. Empty it the day the shop opens, then redeploy.
NOINDEX=1

# Storefront: IndexNow key (Bing, ChatGPT, Copilot are told when pages change), `openssl rand -hex 16`.
# Empty: off.
INDEXNOW_KEY=

# Cloudflare in front of the server: 1 once the domain is active on Cloudflare and Traefik trusts its
# ranges (docs/deploiement.md). The limits then count each visitor, not Cloudflare. Empty = 0, direct access.
CLOUDFLARE_HOPS=
