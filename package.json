{
  "name": "finikura",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:storefront": "pnpm --filter storefront dev",
    "dev:medusa": "pnpm --filter medusa dev",
    "dev:strapi": "pnpm --filter strapi develop",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  }
}
